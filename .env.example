# Copy to .env.local (git-ignored) for local development, or set these in Vercel → Environment Variables.
# VITE_* variables are read at BUILD time: after changing one on Vercel, redeploy.

# ── Analytics ───────────────────────────────────────────────────────────────────────────────
# Google Tag Manager container id (format GTM-XXXXXXX). Empty or malformed → GTM is not loaded.
VITE_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 measurement id (format G-XXXXXXXXXX), loaded directly with gtag.js.
# Leave EMPTY if GA4 is already configured inside the GTM container, otherwise events count twice.
# Empty or malformed → GA4 is not loaded.
VITE_GA4_ID=G-XXXXXXXXXX

# ── Supabase (Project Settings → API) ───────────────────────────────────────────────────────
# Use the *anon* public key, never the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Contact emails (Resend) — used ONLY by the serverless function api/contact.ts ─────────────
# Inbox that receives every contact request. Without it (or without RESEND_API_KEY) no email is sent,
# but the request is still saved in Supabase (table `contacts`, visible in /admin → Consultas).
VITE_CONTACT_EMAIL=info@your-domain.com

# Resend API key (https://resend.com/api-keys). SECRET: server-side only, never give it a VITE_ prefix.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Optional sender. Must belong to a domain verified in Resend. If omitted, Resend's test sender
# (onboarding@resend.dev) is used, which only delivers to the email of your own Resend account.
# RESEND_FROM=Trevisan Inmuebles <consultas@your-domain.com>
